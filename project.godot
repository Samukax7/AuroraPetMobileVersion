; Engine configuration file.
; Aurora Pet Mobile Version — cópia independente da versão principal.
config_version=5

[application]
config/name="Aurora Pet Mobile Version"
config/description="Aurora Pet Mobile Version — cópia independente para telas touch."
config/version="0.1-mobile"
config/tags=PackedStringArray("mobile_copy")
run/main_scene="res://scenes/mobile_main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/UI/aurorapet_icon.png"

[display]
window/size/viewport_width=1080
window/size/viewport_height=650
window/size/window_width_override=1080
window/size/window_height_override=650
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
3d/physics_engine="Jolt Physics"

[rendering]
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.027, 0.075, 0.145, 1)
